# =============================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# =============================================================================

# Application
ENVIRONMENT=production
DOMAIN=yourdomain.com

# Security
SECRET_KEY=CHANGE_THIS_TO_RANDOM_STRING_min_32_chars
FIRST_SUPERUSER=admin@yourdomain.com
FIRST_SUPERUSER_PASSWORD=CHANGE_THIS_SECURE_PASSWORD

# Database
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_THIS_SECURE_PASSWORD
POSTGRES_DB=content_automation

# Redis
REDIS_HOST=redis
REDIS_PASSWORD=CHANGE_THIS_SECURE_PASSWORD

# Traefik
TRAEFIK_AUTH=admin:$apr1$xyz$encrypted_password  # Use: htpasswd -nb admin password

# =============================================================================
# SOCIAL MEDIA API KEYS
# =============================================================================

# YouTube Data API v3
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret

# Facebook Graph API
FACEBOOK_APP_SECRET=your_facebook_app_secret

# Instagram Graph API (uses Facebook credentials)
INSTAGRAM_APP_SECRET=your_instagram_app_secret

# LinkedIn API v2
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret

# Twitter API v2
TWITTER_CLIENT_SECRET=your_twitter_client_secret

# =============================================================================
# CLOUD STORAGE (AWS S3)
# =============================================================================

AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=your-content-bucket
AWS_REGION=us-east-1

# Backup bucket
S3_BACKUP_BUCKET=your-backup-bucket

# =============================================================================
# AI SERVICES
# =============================================================================

# OpenAI (GPT-4)
OPENAI_API_KEY=sk-your_openai_api_key

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key

# =============================================================================
# MONITORING & LOGGING
# =============================================================================

# Sentry (Error Tracking)
SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_THIS_SECURE_PASSWORD

# =============================================================================
# EMAIL (SMTP)
# =============================================================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_TLS=true
SMTP_SSL=false
EMAILS_FROM_EMAIL=noreply@yourdomain.com
EMAILS_FROM_NAME="Content Automation Platform"

# =============================================================================
# API LIMITS & PERFORMANCE
# =============================================================================

# Rate limiting
API_RATE_LIMIT=100  # requests per minute
WORKER_CONCURRENCY=4

# Database connection pool
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# =============================================================================
# FRONTEND
# =============================================================================

FRONTEND_HOST=https://yourdomain.com
VITE_API_URL=https://yourdomain.com/api

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================

BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE=0 3 * * *  # Daily at 3 AM

# =============================================================================
# SECURITY HEADERS
# =============================================================================

CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
